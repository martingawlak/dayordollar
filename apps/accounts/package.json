    "@mgc/brands": "*",
    "@privy-io/react-auth": "^3.51.0",
    "better-auth": "1.7.12",
    "hono": "^4.13.13",
    "jose": "^6.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251001.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "wrangler": "^4.152.0"
  }

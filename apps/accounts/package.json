{
  "name": "@mgc/accounts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build && wrangler dev",
    "build": "vite build",
    "check": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply mgc-accounts --remote",

---
import Base from "../../layouts/Base.astro";
---
<Base title="Door" staff>
  <header class="hero" style="padding-top:12px">
    <h1><span class="ticker">Dead Dreams Booking</span><span class="name">Door</span></h1>
    <p class="lede" id="who"></p>
  </header>

  <p class="note" id="gate" hidden></p>

  <div id="app" hidden style="display:grid;gap:16px;max-width:460px;width:100%;margin:0 auto">
    <label class="field"><span>Show</span><select id="event"></select></label>
    <div class="row" style="margin:0"><span>Checked in</span><b id="count">0 / 0</b></div>

    <div class="scan" id="scanBox">
      <video id="video" playsinline muted></video>
      <canvas id="canvas" hidden></canvas>
      <div class="aim" aria-hidden="true"></div>
      <button class="btn primary center" id="start" type="button">Start scanning</button>
    </div>

    <div class="result" id="result" hidden aria-live="assertive"><b id="resTitle"></b><span id="resText"></span></div>

    <form id="manual" class="copy" style="margin:0">
      <input type="text" id="code" placeholder="Or type the ticket code" autocapitalize="characters" autocomplete="off" spellcheck="false">
      <button type="submit">Check in</button>
    </form>
  </div>
</Base>

<style is:global>
  .scan { position: relative; border-radius: 14px; overflow: hidden; background: #111; aspect-ratio: 1; display: grid; place-items: center; }
  .scan video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .scan .aim { position: absolute; inset: 18%; border: 3px solid rgba(255, 255, 255, .85); border-radius: 18px; box-shadow: 0 0 0 999px rgba(0, 0, 0, .25); pointer-events: none; }
  .scan #start { position: relative; z-index: 2; width: auto; }
  .result { display: grid; gap: 4px; text-align: center; border-radius: 14px; padding: 18px; color: #fff; }
  .result b { font-family: var(--head); font-size: 30px; letter-spacing: 1px; text-transform: uppercase; }
  .result span { font-size: 16px; }
  .result.ok { background: var(--ok); }
  .result.no { background: var(--bad); }
</style>

<script>
  import jsQR from "jsqr";
  import { $, api, esc, showDate } from "../../scripts/util.ts";
  import { celebrate } from "../../scripts/joy.ts";

  const KEY = "deaddreams.doorEvent";
  const video = $("video") as HTMLVideoElement, canvas = $("canvas") as HTMLCanvasElement, select = $("event") as HTMLSelectElement;
  let events: any[] = [];
  let last = { code: "", at: 0 };
  let busy = false;

  async function loadEvents() {
    const d = await api<{ events: any[]; staff: any }>("/api/door/checkin");
    events = d.events;
    $("who").textContent = `Signed in as ${d.staff.user.email}`;
    $("app").hidden = false;
    if (!events.length) { select.innerHTML = `<option value="">No shows on sale from today on</option>`; return; }
    const saved = (() => { try { return localStorage.getItem(KEY); } catch { return null; } })();
    select.innerHTML = events.map((e) => `<option value="${e.id}">${esc(e.title)} · ${showDate(e.starts_at)}</option>`).join("");
    if (saved && events.some((e) => e.id === saved)) select.value = saved;
    paintCount();
  }
  function paintCount() {
    const e = events.find((x) => x.id === select.value);
    $("count").textContent = e ? `${e.checked_in} / ${e.tickets}` : "0 / 0";
  }
  select.addEventListener("change", () => { try { localStorage.setItem(KEY, select.value); } catch {} paintCount(); });

  function beep(ok: boolean) {
    try {
      const a = new (window.AudioContext || (window as any).webkitAudioContext)();
      const o = a.createOscillator(), g = a.createGain();
      o.frequency.value = ok ? 880 : 220; o.type = ok ? "sine" : "square";
      g.gain.setValueAtTime(0.15, a.currentTime); g.gain.exponentialRampToValueAtTime(0.0001, a.currentTime + (ok ? 0.25 : 0.5));
      o.connect(g); g.connect(a.destination); o.start(); o.stop(a.currentTime + 0.5);
      navigator.vibrate?.(ok ? 60 : [120, 60, 120]);
    } catch {}
  }

  async function checkIn(raw: string) {
    const code = raw.trim();
    if (!code || busy || !select.value) return;
    if (code === last.code && Date.now() - last.at < 4000) return; // same QR still in view
    last = { code, at: Date.now() };
    busy = true;
    try {
      const r = await api<any>("/api/door/checkin", { method: "POST", json: { event: select.value, code } });
      const box = $("result");
      box.hidden = false;
      box.className = `result ${r.ok ? "ok" : "no"}`;
      $("resTitle").textContent = r.ok ? "Welcome in" : "Stop";
      $("resText").textContent = r.ok
        ? `${r.name} · ticket ${r.seq} of ${r.of} · ${r.order}`
        : `${r.reason}${r.name ? ` (${r.name}, ${r.order})` : ""}${r.at ? ` at ${new Date(r.at).toLocaleTimeString([], { hour: "numeric", minute: "2-digit" })}` : ""}`;
      beep(r.ok);
      if (r.ok) {
        const e = events.find((x) => x.id === select.value);
        if (e) { e.checked_in++; paintCount(); }
      }
    } catch (e: any) {
      $("result").hidden = false;
      $("result").className = "result no";
      $("resTitle").textContent = "Try again";
      $("resText").textContent = e.message;
    } finally {
      busy = false;
    }
  }

  async function start() {
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: "environment" }, audio: false });
      video.srcObject = stream;
      await video.play();
      $("start").hidden = true;
    } catch {
      $("start").textContent = "Camera blocked · type codes below";
      return;
    }
    const detector = "BarcodeDetector" in window ? new (window as any).BarcodeDetector({ formats: ["qr_code"] }) : null;
    const ctx = canvas.getContext("2d", { willReadFrequently: true })!;
    const tick = async () => {
      if (video.readyState >= 2 && !busy) {
        let code = "";
        if (detector) {
          try { code = (await detector.detect(video))[0]?.rawValue || ""; } catch {}
        } else {
          const w = (canvas.width = Math.min(640, video.videoWidth)), h = (canvas.height = Math.round((video.videoHeight / video.videoWidth) * w));
          ctx.drawImage(video, 0, 0, w, h);
          code = jsQR(ctx.getImageData(0, 0, w, h).data, w, h, { inversionAttempts: "dontInvert" })?.data || "";
        }
        if (code) await checkIn(code);
      }
      setTimeout(() => requestAnimationFrame(tick), 120);
    };
    tick();
  }
  $("start").addEventListener("click", start);
  $("manual").addEventListener("submit", (e) => {
    e.preventDefault();
    last.code = "";
    checkIn(($("code") as HTMLInputElement).value);
    ($("code") as HTMLInputElement).value = "";
  });
  $("result").addEventListener("click", () => celebrate($("result")));

  loadEvents().catch((e) => {
    $("gate").hidden = false;
    $("gate").innerHTML = e.data?.signIn
      ? `Staff only. <a href="/auth/login?returnTo=/door/">Sign in</a> with your Martin Gawlak Company account.`
      : `${esc(e.message)} Ask an admin to add your email to DOOR_EMAILS.`;
  });
</script>

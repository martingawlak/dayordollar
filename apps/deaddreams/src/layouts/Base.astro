---
import { ACCOUNTS_URL, brands } from "@mgc/brands";
import { SITE } from "../config";
import "../styles/house.css";

interface Props {
  title?: string;
  description?: string;
  /** Staff pages: kept out of search and given a wider board. */
  staff?: boolean;
}
const { title, description = `${SITE.name}: ${SITE.tagline}. Tickets for upcoming shows.`, staff = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} · ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const others = brands.filter((b) => b.id !== "deaddreams");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>{fullTitle}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonical}>
    {staff && <meta name="robots" content="noindex">}
    <meta property="og:type" content="website">
    <meta property="og:site_name" content={SITE.name}>
    <meta property="og:title" content={fullTitle}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={new URL("/icons/icon-512.png", Astro.site)}>
    <meta name="twitter:card" content="summary">
    <meta name="theme-color" content="#ff00e1">
    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content={SITE.shortName}>
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Petit+Formal+Script&family=Oswald:wght@400;500;600&family=Open+Sans:wght@400;600;700&family=Lato:wght@400;700&display=swap">
  </head>
  <body>
    <div class="sky" id="sky" aria-hidden="true"><div id="uni">🦄</div></div>

    <nav class={`nav${staff ? " wide-nav" : ""}`} id="nav" aria-label="Site">
      <div class="nav-bar">
        <a class="nav-home" href="/">{SITE.name}</a>
        <div class="nav-actions">
          <a class="nav-link" href="/tickets/">My tickets</a>
          <button class="nav-toggle" id="navToggle" type="button" aria-expanded="false" aria-controls="navList">Menu</button>
        </div>
      </div>
      <ul class="nav-list" id="navList">
        <li class="nav-account" id="account" data-accounts={ACCOUNTS_URL}>
          <a href="/auth/login" id="signIn">Sign in<small>One Martin Gawlak Company account for every brand</small></a>
        </li>
        <li><a href="/">Upcoming shows</a></li>
        <li><a href="/tickets/">My tickets</a></li>
        {SITE.facebookPage && <li><a href={SITE.facebookPage} rel="noopener">Dead Dreams on Facebook</a></li>}
        {others.map((b) => <li><a href={b.url}>{b.name}{b.tagline && <small>{b.tagline}</small>}</a></li>)}
        <li><a href="/door/">Door scanner <small>staff</small></a></li>
        <li><a href="/admin/">Admin <small>staff</small></a></li>
      </ul>
    </nav>

    <main class={`wrap${staff ? " wide" : ""}`} id="main">
      <slot />
    </main>

    <div class="install" id="install" hidden>
      <span>Add Dead Dreams to your home screen for your tickets</span>
      <button class="yes" id="installYes" type="button">Install</button>
      <button class="no" id="installNo" type="button" aria-label="Not now">✕</button>
    </div>

    <script>
      const nav = document.getElementById("nav")!, toggle = document.getElementById("navToggle")!;

      // The shared Martin Gawlak Company account, same as every brand site: sign in once, signed in everywhere.
      const account = document.getElementById("account")!;
      const signIn = document.getElementById("signIn") as HTMLAnchorElement;
      signIn.href = `/auth/login?returnTo=${encodeURIComponent(location.pathname + location.search)}`;
      fetch("/auth/me", { credentials: "same-origin" })
        .then((r) => (r.ok ? r.json() : null))
        .then((d) => {
          const user = d?.user;
          if (!user) return;
          const first = (user.name || user.email).split(/[\s@]/)[0];
          account.innerHTML = `<a href="${account.dataset.accounts}/account"></a><a href="/auth/logout">Sign out</a>`;
          const me = account.querySelector("a")!;
          me.textContent = `Hi, ${first}`;
          const small = document.createElement("small");
          small.textContent = `${user.email} · My account`;
          me.append(small);
          toggle.textContent = first.slice(0, 12);
          toggle.dataset.label = toggle.textContent;
        })
        .catch(() => {});
      toggle.addEventListener("click", () => {
        const open = nav.classList.toggle("open");
        toggle.setAttribute("aria-expanded", String(open));
        toggle.textContent = open ? "Close" : toggle.dataset.label || "Menu";
      });

      // The installable app: offline tickets and the door scanner work from the home screen.
      if ("serviceWorker" in navigator) addEventListener("load", () => navigator.serviceWorker.register("/sw.js").catch(() => {}));

      let deferred: any = null;
      const bar = document.getElementById("install")!;
      const dismissed = () => { try { return localStorage.getItem("deaddreams.installNo") === "1"; } catch { return false; } };
      addEventListener("beforeinstallprompt", (e) => {
        e.preventDefault();
        deferred = e;
        if (!dismissed()) bar.hidden = false;
      });
      document.getElementById("installYes")!.addEventListener("click", async () => {
        bar.hidden = true;
        if (deferred) { deferred.prompt(); deferred = null; }
      });
      document.getElementById("installNo")!.addEventListener("click", () => {
        bar.hidden = true;
        try { localStorage.setItem("deaddreams.installNo", "1"); } catch {}
      });
    </script>
  </body>
</html>

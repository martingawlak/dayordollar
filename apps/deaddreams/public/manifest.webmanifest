{
  "name": "Dead Dreams Booking",
  "short_name": "Dead Dreams",
  "description": "Tickets for Dead Dreams shows. Your tickets open offline at the door.",
  "id": "/",
  "start_url": "/?source=app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#ff00e1",
  "categories": ["entertainment", "music", "events"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "My tickets", "url": "/tickets/", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Door scanner", "url": "/door/", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}

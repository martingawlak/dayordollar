# Copy to .dev.vars for local `npm run preview`. Never commit real values.
# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
PAYPAL_ENV=sandbox
SSO_ISSUER=http://localhost:8787/api/auth
SSO_CLIENT_ID=...
SSO_CLIENT_SECRET=...
SESSION_SECRET=generate-with-openssl-rand-base64-32
RESEND_API_KEY=re_...
FB_PAGE_ID=...
FB_PAGE_TOKEN=...
# Local only: treat every request from localhost as this staff member (skips sign-in).
DEV_STAFF_EMAIL=hello@martingawlakcompany.com

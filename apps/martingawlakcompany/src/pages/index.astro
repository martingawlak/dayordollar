---
import Base from "../layouts/Base.astro";
// The old front page, exactly: its two headings, then the [mgc_zora] block as
// the MGC Zora Launchpad plugin (v0.26.1) rendered it, styles and scripts included.
import launchpad from "../data/mgc-zora-home.html?raw";
// The trading widget the plugin loaded beside it: its styles, settings and bundle.
import dappCss from "../data/mgc-zora-dapp.css?raw";
import dappCfg from "../data/mgc-zora-dapp.json";
// The Zora API key is optional (it raises Zora's rate limits); set PUBLIC_ZORA_API_KEY at build time.
const zlpCfg = { ...dappCfg, apiKey: import.meta.env.PUBLIC_ZORA_API_KEY ?? "", ajaxUrl: "", nonce: "", user: "" };
---
<Base title="Martin Gawlak Company" description="Martin Gawlak Company: prolific strategic equity. Marketing for small businesses in Fort Pierce and Sarasota, and the home of the Gawlak family of brands.">
  <section class="home-box">
    <div class="wrap">
      <h1 class="home-title">Martin Gawlak Company</h1>
      <h2 class="home-sub">Own Martin Gawlak and Company's Brands</h2>
      <Fragment set:html={launchpad} />
      <style is:inline set:html={dappCss}></style>
      <script is:inline define:vars={{ zlpCfg }}>window.ZLP_CFG = zlpCfg;</script>
      <script is:inline src="/wp-content/plugins/mgc-zora-launchpad/assets/zora-launchpad.js" defer></script>
    </div>
  </section>
</Base>

---
import { nav } from "../lib/nav";
const year = new Date().getFullYear();
// The old footer: the main menu, the marketing menu, and the social links.
const footerMenu = [
  ["Marketing Library", "/marketing-library/"], ["SEO", "/seo/"], ["Marketing Strategies", "/marketing-strategies/"],
  ["Social Media Marketing", "/social-media-marketing/"], ["Google Ads", "/google-ads/"], ["Website Design and Development", "/website-design/"],
  ["Email Marketing", "/email-marketing/"], ["Marketing Terms", "/marketing-terms/"], ["Marketing", "/marketing/"], ["Sales", "/sales/"],
  ["Performance Marketing Hacks", "/performance-marketing-hacks/"], ["Storytelling", "/selling-through-storytelling/"], ["Text Marketing", "/text-marketing/"],
];
const social = [
  ["Facebook", "f", "https://www.facebook.com/martingawlakcompany/"], ["Spotify", "♫", "https://open.spotify.com/show/5bwuG7khT9cL9LyTuY1IRz"],
  ["YouTube", "▶", "https://www.youtube.com/channel/UC_uW_8gfAHBMOoNCuwRRGcQ"], ["Google", "G", "https://www.google.com/search?q=martin+gawlak+company"],
  ["Instagram", "ig", "https://www.instagram.com/martingawlakcompany/"], ["LinkedIn", "in", "https://www.linkedin.com/in/martingawlak"],
  ["TikTok", "♪", "https://www.tiktok.com/@martingawlakcompany"],
];
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <ul>
      {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
    <ul>
      {footerMenu.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
    </ul>
    <div class="social">
      {social.map(([label, mark, href]) => <a href={href} aria-label={label} title={label} rel="noopener" target="_blank">{mark}</a>)}
    </div>
  </div>
  <p class="copyright">Copyright © {year} Martin Gawlak Company | (772)242-3534</p>
</footer>

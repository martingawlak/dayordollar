{
  "name": "martin-gawlak-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:site": "npm run dev -w @mgc/site",
    "dev:accounts": "npm run dev -w @mgc/accounts",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  }
}
